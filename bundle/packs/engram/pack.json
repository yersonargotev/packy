{
  "id": "engram",
  "version": "1.0.1",
  "description": "Persistent memory for agent work",
  "selectable": true,
  "surfaces": [
    "claude",
    "codex",
    "opencode"
  ],
  "readiness_obligations": [
    "runtime-usability",
    "surface-authorization"
  ],
  "external_requirements": [
    "engram"
  ],
  "resources": [
    {
      "description": "Guides agents to recall prior project work and preserve durable decisions and discoveries",
      "kind": "instruction",
      "id": "engram-memory",
      "source": "instructions/engram-memory.md",
      "requires": [],
      "bindings": [
        {
          "surface": "claude",
          "projection": "instruction",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "shared",
          "capabilities": []
        },
        {
          "surface": "codex",
          "projection": "instruction",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "shared",
          "capabilities": [
            {
              "type": "project-instruction",
              "project_instruction": {
                "id": "engram-memory",
                "source": "instructions/engram-memory.md"
              }
            }
          ]
        },
        {
          "surface": "opencode",
          "projection": "instruction",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "shared",
          "capabilities": [
            {
              "type": "project-instruction",
              "project_instruction": {
                "id": "engram-memory",
                "source": "instructions/engram-memory.md"
              }
            }
          ]
        }
      ],
      "surface_exclusions": [],
      "conflicts": []
    },
    {
      "description": "Runs Engram's host setup so Codex and OpenCode receive their native memory integration",
      "kind": "lifecycle",
      "id": "engram-memory",
      "requires": [],
      "bindings": [
        {
          "surface": "codex",
          "projection": "lifecycle",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        },
        {
          "surface": "opencode",
          "projection": "lifecycle",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        }
      ],
      "surface_exclusions": [
        {
          "surface": "claude",
          "mode": "optional",
          "code": "generic-lifecycle-unsupported",
          "reason": "Generic lifecycle translation is unsupported on Claude; Packy uses the native instruction and exact user MCP binding and does not execute `engram setup claude-code`."
        }
      ],
      "conflicts": []
    },
    {
      "description": "Makes Engram memory tools available to agents through MCP",
      "kind": "mcp_server",
      "id": "engram",
      "command": "engram",
      "args": [
        "mcp",
        "--tools=agent"
      ],
      "requires": [],
      "bindings": [
        {
          "surface": "claude",
          "projection": "mcp_server",
          "name": "engram",
          "invocation": "engram",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        },
        {
          "surface": "codex",
          "projection": "mcp_server",
          "name": "engram",
          "invocation": "engram",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        },
        {
          "surface": "opencode",
          "projection": "mcp_server",
          "name": "engram",
          "invocation": "engram",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        }
      ],
      "surface_exclusions": [],
      "conflicts": []
    }
  ],
  "exclusions": []
}
