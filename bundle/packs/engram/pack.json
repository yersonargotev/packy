      "surface_exclusions": [],
      "conflicts": []
    },
    {
      "description": "Runs Engram's host setup so Codex and OpenCode receive their native memory integration",
      "kind": "lifecycle",
      "id": "engram-memory",
      "requires": [],
      "bindings": [
        {
          "surface": "codex",
          "projection": "lifecycle",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
        },
        {
          "surface": "opencode",
          "projection": "lifecycle",
          "name": "engram-memory",
          "invocation": "engram-memory",
          "mode": "native",
          "sharing": "exclusive",
          "capabilities": []
