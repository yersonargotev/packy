{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/pack-source/v2.3.0/pack-source-validation.schema.json",
  "title": "Pack source sandbox validation proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "plan_id",
    "base_sha",
    "candidate_sha",
    "source_lock_sha256",
    "lock_set_sha256",
    "config_sha256",
    "manifests_sha256",
    "result_tree_sha",
    "packy_suite",
    "apply",
    "contains_upstream_bytes"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "source_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "plan_id": { "type": "string", "minLength": 1 },
    "base_sha": { "$ref": "#/$defs/full_sha" },
    "candidate_sha": { "$ref": "#/$defs/full_sha" },
    "source_lock_sha256": { "$ref": "#/$defs/sha256" },
    "lock_set_sha256": { "$ref": "#/$defs/sha256" },
    "config_sha256": { "$ref": "#/$defs/sha256" },
    "manifests_sha256": { "$ref": "#/$defs/sha256" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "proposed_version": { "type": "string", "minLength": 1 },
    "proposed_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "legal_evidence_reference": { "type": "string", "minLength": 1 },
    "legal_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "result_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "result_tree_sha": { "$ref": "#/$defs/full_sha" },
    "packy_suite": { "const": true },
    "apply": { "const": true },
    "contains_upstream_bytes": { "const": false },
    "closing_issue": { "$ref": "#/$defs/closing_issue" }
  },
  "allOf": [
    {
      "if": { "required": ["pack_id"] },
      "then": {
        "required": ["proposed_version", "proposed_manifest_sha256", "legal_evidence_reference", "legal_evidence_sha256", "result_bundle_sha256"]
      }
    }
  ],
  "$defs": {
    "full_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "closing_issue": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}/issues/[1-9][0-9]*$" }
  }
}

