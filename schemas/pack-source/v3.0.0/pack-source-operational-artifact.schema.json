{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/pack-source/v3.0.0/pack-source-operational-artifact.schema.json",
  "title": "Composite bundle inspection, classification, or blocked artifact",
  "$comment": "Blocked artifacts always seal the Pack generation and ordered registration/legal identities. Their nested plan is absent before Check succeeds or is one complete sealed plan group. Inspection and classification require the complete result identity. Canonical ordering and cross-document equality remain runtime-enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "source_ids",
    "registration_bundle_sha256",
    "proposed_version",
    "proposed_manifest_sha256",
    "members",
    "contains_secrets",
    "contains_upstream_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "pack_id": {
      "$ref": "#/$defs/source_id"
    },
    "source_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_id"
      }
    },
    "registration_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proposed_version": {
      "type": "string",
      "minLength": 1
    },
    "proposed_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "$ref": "#/$defs/full_sha"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifests_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lock_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan": {
      "$ref": "#/$defs/failure_plan"
    },
    "state": {
      "const": "blocked"
    },
    "classification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contains_secrets": {
      "const": false
    },
    "contains_upstream_bytes": {
      "const": false
    }
  },
  "oneOf": [
    {
      "required": [
        "plan_id",
        "base_sha",
        "config_sha256",
        "manifests_sha256",
        "lock_set_sha256",
        "result_bundle_sha256"
      ],
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "classification_sha256"
            ]
          },
          {
            "required": [
              "blockers"
            ]
          },
          {
            "required": [
              "recovery"
            ]
          },
          {
            "required": [
              "plan"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "plan_id",
        "base_sha",
        "config_sha256",
        "manifests_sha256",
        "lock_set_sha256",
        "result_bundle_sha256",
        "classification_sha256"
      ],
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "blockers"
            ]
          },
          {
            "required": [
              "recovery"
            ]
          },
          {
            "required": [
              "plan"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "state",
        "blockers",
        "recovery"
      ],
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/failure_member"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "plan_id"
            ]
          },
          {
            "required": [
              "base_sha"
            ]
          },
          {
            "required": [
              "config_sha256"
            ]
          },
          {
            "required": [
              "manifests_sha256"
            ]
          },
          {
            "required": [
              "lock_set_sha256"
            ]
          },
          {
            "required": [
              "result_bundle_sha256"
            ]
          },
          {
            "required": [
              "classification_sha256"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "full_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "candidate_sha",
        "source_lock_sha256",
        "legal_evidence_ref",
        "legal_evidence_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "candidate_sha": {
          "$ref": "#/$defs/full_sha"
        },
        "source_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "legal_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "legal_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "failure_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "candidate_sha",
        "legal_evidence_ref",
        "legal_evidence_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "legal_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "legal_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_sha": {
          "$ref": "#/$defs/full_sha"
        }
      }
    },
    "failure_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "base_sha",
        "config_sha256",
        "manifests_sha256",
        "lock_set_sha256",
        "result_bundle_sha256",
        "members"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "$ref": "#/$defs/full_sha"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifests_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lock_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    }
  }
}

