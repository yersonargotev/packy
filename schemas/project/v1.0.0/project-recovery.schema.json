{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v1.0.0/project-recovery.schema.json",
  "title": "Packy project lifecycle recovery report v1",
  "type": "object",
  "required": ["schema_version", "report", "operation", "status", "next_command"],
  "properties": {
    "schema_version": { "const": 1 },
    "report": { "const": "project-recovery" },
    "operation": { "enum": ["install", "uninstall", "update"] },
    "status": { "enum": ["required", "recovered"] },
    "next_command": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
