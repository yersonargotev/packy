{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v1.0.0/project-manifest.schema.json",
  "title": "Packy project manifest contract v1",
  "type": "object",
  "required": ["schema_version", "packs"],
  "properties": {
    "schema_version": { "const": 1 },
    "packs": { "type": "array", "minItems": 1, "items": { "$ref": "project-contract-defs.schema.json#/$defs/manifest_pack" } }
  },
  "additionalProperties": false
}
