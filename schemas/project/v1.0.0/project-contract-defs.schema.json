{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v1.0.0/project-contract-defs.schema.json",
  "title": "Packy project lifecycle shared definitions v1.0.0",
  "$defs": {
    "surface": { "enum": ["claude", "codex", "opencode"] },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["mode", "roots"],
      "properties": {
        "mode": { "enum": ["all", "custom"] },
        "roots": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      },
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "surface_intent": {
      "type": "object",
      "required": ["surface", "version", "selection", "aliases"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "version": { "type": "string", "minLength": 1 },
        "selection": { "$ref": "#/$defs/selection" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } }
      },
      "additionalProperties": false
    },
    "manifest_pack": {
      "type": "object",
      "required": ["id", "surface_intents"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "surface_intents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface_intent" } }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": ["id", "version", "surfaces", "selection", "aliases"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "selection": { "$ref": "#/$defs/selection" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "surface_intents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface_intent" } }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["code", "detail", "remediation"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "detail": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "installed_pack": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resource_fact": {
      "type": "object",
      "required": ["resource", "role", "dependency_chain", "requires", "notices"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "role": { "enum": ["root", "dependency", "asset", "notice", "unselected"] },
        "dependency_chain": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "notices": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      },
      "additionalProperties": false
    },
    "installed_projection": {
      "type": "object",
      "required": ["id", "target", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file_mode": { "type": "integer", "minimum": 1, "maximum": 511 }
      },
      "additionalProperties": false
    },
    "installed_receipt": {
      "type": "object",
      "required": ["pack", "surface", "readiness_obligations", "external_requirements", "selection", "resources", "projections"],
      "properties": {
        "pack": { "$ref": "#/$defs/installed_pack" },
        "surface": { "$ref": "#/$defs/surface" },
        "readiness_obligations": {
          "type": "array",
          "items": { "enum": ["runtime-usability", "surface-authorization"] },
          "uniqueItems": true
        },
        "external_requirements": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
        "selection": { "$ref": "#/$defs/selection" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "projections": { "type": "array", "items": { "$ref": "#/$defs/installed_projection" } },
        "sensitive": { "type": "array", "items": { "$ref": "#/$defs/sensitive" } }
      },
      "additionalProperties": false
    },
    "projection_plan": {
      "type": "object",
      "required": ["resource", "target", "mode", "file_mode", "observed_state", "owner_pack", "surface"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "mode": { "type": "string", "minLength": 1 },
        "file_mode": { "type": "integer", "minimum": 0 },
        "desired_fingerprint": { "type": "string" },
        "observed_state": { "type": "string", "minLength": 1 },
        "owner_pack": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "projection_status": {
      "type": "object",
      "required": ["resource", "target", "mode", "health", "observed_fingerprint", "desired_fingerprint", "owner_pack", "surface"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "mode": { "type": "string" },
        "health": { "type": "string" },
        "observed_fingerprint": { "type": "string" },
        "desired_fingerprint": { "type": "string" },
        "owner_pack": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" }
      },
      "additionalProperties": false
    },
    "sensitive": {
      "type": "object",
      "required": ["category", "surface", "resource", "detail"],
      "properties": {
        "category": { "enum": ["mcp", "hooks", "plugins", "external-requirements", "trust", "authentication"] },
        "surface": { "$ref": "#/$defs/surface" },
        "resource": { "$ref": "#/$defs/resource" },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime_effect": {
      "type": "object",
      "required": ["category", "resource", "detail", "coverage"],
      "properties": {
        "category": { "type": "string" },
        "resource": { "$ref": "#/$defs/resource" },
        "detail": { "type": "string" },
        "coverage": { "enum": ["pending", "project", "inherited-global", "global-and-project", "conflict"] },
        "global_version": { "type": "string" },
        "conflict": { "type": "string" }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["configured", "authorized", "usable"],
      "properties": {
        "configured": { "enum": ["true", "false", "unknown"] },
        "authorized": { "enum": ["true", "false", "unknown"] },
        "usable": { "enum": ["true", "false", "unknown"] }
      },
      "additionalProperties": false
    },
    "readiness_condition": {
      "type": "object",
      "required": ["type", "scope", "dimension", "value", "reason", "message", "evidence", "freshness"],
      "properties": {
        "type": { "enum": ["projection-integrity", "external-requirement", "surface-authorization", "runtime-usability"] },
        "scope": { "type": "object", "required": ["kind", "pack", "surface"], "properties": { "kind": { "enum": ["global", "project"] }, "pack": { "type": "string" }, "surface": { "$ref": "#/$defs/surface" }, "resource": { "$ref": "#/$defs/resource" } }, "additionalProperties": false },
        "dimension": { "enum": ["configured", "authorized", "usable"] },
        "value": { "enum": ["true", "false", "unknown"] },
        "reason": { "type": "string" }, "message": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } },
        "freshness": { "type": "object", "required": ["observed_at", "validity_identity"], "properties": { "observed_at": { "type": "string", "format": "date-time" }, "validity_identity": { "type": "string" } }, "additionalProperties": false }
      }, "additionalProperties": false
    }
  }
}
