{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v1.0.0/project-contract-defs.schema.json",
  "title": "Packy project lifecycle shared definitions v1.0.0",
  "$defs": {
    "surface": { "enum": ["claude", "codex", "opencode"] },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["mode", "roots"],
      "properties": {
        "mode": { "enum": ["all", "custom"] },
        "roots": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      },
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provider_choice": {
      "type": "object",
      "required": ["capability", "provider_pack"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "provider_pack": { "type": "string", "minLength": 1 },
        "provider_resource": { "$ref": "#/$defs/resource" }
      },
      "additionalProperties": false
    },
    "surface_intent": {
      "type": "object",
      "required": ["surface", "selection", "aliases", "provider_choices"],
      "properties": {
        "surface": { "$ref": "#/$defs/surface" },
        "selection": { "$ref": "#/$defs/selection" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "provider_choices": { "type": "array", "items": { "$ref": "#/$defs/provider_choice" } }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": ["id", "version", "surfaces", "selection", "aliases", "provider_choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "selection": { "$ref": "#/$defs/selection" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "provider_choices": { "type": "array", "items": { "$ref": "#/$defs/provider_choice" } },
        "surface_intents": { "type": "array", "items": { "$ref": "#/$defs/surface_intent" } }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["code", "detail", "remediation"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "detail": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["pack_id", "pack_version", "manifest_schema", "source_id", "provider", "repository", "commit", "tree", "source_lock_sha256"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "pack_version": { "type": "string", "minLength": 1 },
        "manifest_schema": { "type": "integer", "minimum": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 },
        "reference": { "type": "string" },
        "source_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "resource_fact": {
      "type": "object",
      "required": ["resource", "role", "dependency_chain", "requires", "notices"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "role": { "enum": ["root", "dependency", "asset", "notice", "unselected"] },
        "dependency_chain": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "notices": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      },
      "additionalProperties": false
    },
    "resource_graph": {
      "type": "object",
      "required": ["resources"],
      "properties": { "resources": { "type": "array", "items": { "$ref": "#/$defs/resource_fact" } } },
      "additionalProperties": false
    },
    "projection_plan": {
      "type": "object",
      "required": ["resource", "target", "mode", "file_mode", "observed_state", "contributor"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "mode": { "type": "string", "minLength": 1 },
        "file_mode": { "type": "integer", "minimum": 0 },
        "desired_fingerprint": { "type": "string" },
        "observed_state": { "type": "string", "minLength": 1 },
        "contributor": { "type": "string", "minLength": 1 },
        "contributors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "discoverable_by": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
      },
      "additionalProperties": false
    },
    "projection_status": {
      "type": "object",
      "required": ["resource", "target", "mode", "health", "observed_fingerprint", "desired_fingerprint", "contributor"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "target": { "type": "string" },
        "mode": { "type": "string" },
        "health": { "type": "string" },
        "observed_fingerprint": { "type": "string" },
        "desired_fingerprint": { "type": "string" },
        "contributor": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sensitive": {
      "type": "object",
      "required": ["category", "surface", "resource", "detail"],
      "properties": {
        "category": { "enum": ["mcp", "hooks", "plugins", "external-requirements", "trust", "authentication"] },
        "surface": { "$ref": "#/$defs/surface" },
        "resource": { "$ref": "#/$defs/resource" },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime_effect": {
      "type": "object",
      "required": ["category", "resource", "detail", "coverage"],
      "properties": {
        "category": { "type": "string" },
        "resource": { "$ref": "#/$defs/resource" },
        "detail": { "type": "string" },
        "coverage": { "enum": ["pending", "project", "inherited-global", "global-and-project", "conflict"] },
        "global_version": { "type": "string" },
        "conflict": { "type": "string" }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["configured", "authorized", "usable"],
      "properties": {
        "configured": { "type": "boolean" },
        "authorized": { "type": "boolean" },
        "usable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
