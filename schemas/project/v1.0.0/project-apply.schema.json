{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v1.0.0/project-apply.schema.json",
  "title": "Packy project lifecycle apply reports",
  "type": "object",
  "required": ["schema_version", "report", "status"],
  "properties": {
    "schema_version": { "const": 2 },
    "report": { "enum": ["project-install-apply", "project-uninstall-apply", "project-activation-apply", "project-deactivation-apply"] },
    "status": { "type": "string", "minLength": 1 },
    "observation": { "type": "string" },
    "digest": { "type": "string" },
    "readiness": { "$ref": "project-contract-defs.schema.json#/$defs/readiness" },
    "conditions": { "type": "array", "items": { "$ref": "project-contract-defs.schema.json#/$defs/readiness_condition" } }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "report": { "enum": ["project-install-apply", "project-activation-apply"] } } },
      "then": { "required": ["readiness", "conditions"] }
    }
  ]
}
