{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/project/v2/project-lock.schema.json",
  "title": "Packy project receipt lock contract v2",
  "type": "object",
  "required": [
    "schema_version",
    "receipts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "project-contract-defs.schema.json#/$defs/installed_receipt"
      }
    }
  },
  "additionalProperties": false
}
