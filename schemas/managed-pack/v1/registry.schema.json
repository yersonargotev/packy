{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yersonargotev/packy/schemas/managed-pack/v1/registry.schema.json",
  "title": "Managed Pack Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packs"],
  "properties": {
    "schema_version": {"const": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "project"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "project": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
        }
      }
    }
  }
}
