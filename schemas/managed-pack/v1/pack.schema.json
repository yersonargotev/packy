{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yersonargotev/packy/schemas/managed-pack/v1/pack.schema.json",
  "title": "Managed Pack Project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "selectable",
    "surfaces",
    "readiness_obligations",
    "external_requirements",
    "origins",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/semver"},
    "description": {"type": "string", "minLength": 1},
    "selectable": {"type": "boolean"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["claude", "codex", "opencode"]}
    },
    "readiness_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["runtime-usability", "surface-authorization"]}
    },
    "external_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "origins": {
      "type": "array",
      "items": {"$ref": "#/$defs/origin"}
    },
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "commit"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "resourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "relationship"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "relationship": {"enum": ["exact-copy", "adapted"]}
      }
    },
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "agentAuthorityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable", "declarations", "outcome", "claude_tools", "fallback"],
      "properties": {
        "portable": {"type": "string"},
        "declarations": {"type": "array", "items": {"type": "string"}},
        "outcome": {"type": "string"},
        "claude_tools": {"type": "array", "items": {"type": "string"}},
        "fallback": {"type": "string"}
      }
    },
    "agentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_mode", "authorities"],
      "properties": {
        "permission_mode": {"type": "string"},
        "authorities": {"type": "array", "items": {"$ref": "#/$defs/agentAuthorityRecord"}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "claude-agent-document",
            "claude-composite-skill",
            "external-executable-acquisition",
            "opencode-primary-prompt",
            "project-instruction"
          ]
        },
        "claude_agent_document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skills", "authority"],
          "properties": {
            "skills": {"type": "array", "items": {"$ref": "#/$defs/resourceIdentity"}},
            "authority": {"$ref": "#/$defs/agentAuthority"}
          }
        },
        "claude_composite_skill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dependencies", "references"],
          "properties": {
            "dependencies": {"type": "array", "items": {"$ref": "#/$defs/resourceIdentity"}},
            "references": {"type": "array", "items": {"$ref": "#/$defs/resourceIdentity"}}
          }
        },
        "external_executable_acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {"tool": {"$ref": "#/$defs/id"}}
        },
        "primary_prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "source": {"$ref": "#/$defs/path"}
          }
        },
        "project_instruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "source"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "source": {"$ref": "#/$defs/path"}
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event", "matcher", "command", "args", "timeout_seconds", "blocking", "failure", "authorities"],
      "properties": {
        "type": {"type": "string"},
        "event": {"type": "string"},
        "matcher": {"type": "string"},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "blocking": {"type": "boolean"},
        "failure": {"type": "string"},
        "authorities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "projection", "name", "invocation", "mode", "sharing", "capabilities"],
      "properties": {
        "surface": {"enum": ["claude", "codex", "opencode"]},
        "projection": {"type": "string", "minLength": 1},
        "name": {"$ref": "#/$defs/id"},
        "invocation": {"type": "string", "minLength": 1},
        "mode": {"enum": ["native", "degraded"]},
        "degradation": {"type": "string"},
        "sharing": {"enum": ["exclusive", "shared"]},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "hook": {"$ref": "#/$defs/hook"}
      }
    },
    "surfaceExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "mode", "code", "reason"],
      "properties": {
        "surface": {"enum": ["claude", "codex", "opencode"]},
        "mode": {"enum": ["mandatory", "optional"]},
        "code": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "freeform"]},
        "placeholder": {"type": "string"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "description", "requires", "conflicts", "bindings", "surface_exclusions"],
      "properties": {
        "kind": {"enum": ["agent", "asset", "command", "instruction", "lifecycle", "mcp_server", "notice", "skill"]},
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/path"},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string", "minLength": 1},
        "mode": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "arguments": {"$ref": "#/$defs/arguments"},
        "license": {"type": "string"},
        "attribution": {"type": "string"},
        "requires": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "notices": {"type": "array", "items": {"type": "string"}},
        "origin": {"$ref": "#/$defs/resourceOrigin"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "surface_exclusions": {"type": "array", "items": {"$ref": "#/$defs/surfaceExclusion"}}
      }
    }
  }
}
