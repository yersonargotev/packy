{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v5/pack-show.schema.json",
  "title": "Packy current pack show report v5",
  "type": "object",
  "required": ["schema_version", "report", "catalog_state", "id", "version", "description", "source_identity", "surfaces", "requires", "resource_counts", "resource_inventory", "lifecycle_availability", "surface_contracts", "resource_graph"],
  "properties": {
    "schema_version": { "const": 5 },
    "report": { "const": "pack-show" },
    "catalog_state": { "const": "current" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source_identity": {
      "type": "object",
      "required": ["pack_id", "version", "schema_version", "limitation"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "surfaces": { "type": "array", "items": { "enum": ["claude", "codex", "opencode"] }, "minItems": 1, "uniqueItems": true },
    "requires": {
      "type": "object",
      "required": ["tools"],
      "properties": { "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } },
      "additionalProperties": false
    },
    "resource_counts": { "type": "object" },
    "resource_inventory": {
      "type": "array",
      "items": { "$ref": "#/$defs/descriptive_resource" },
      "uniqueItems": true
    },
    "lifecycle_availability": { "type": "object" },
    "surface_contracts": { "type": "array" },
    "resource_graph": { "type": "object" }
  },
  "$defs": {
    "resource_identity": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["skill", "instruction", "mcp_server", "lifecycle", "agent", "command", "asset", "notice"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptive_resource": {
      "type": "object",
      "required": ["resource", "description", "role", "dependencies", "notices"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource_identity" },
        "description": { "type": "string", "minLength": 1 },
        "role": { "enum": ["operational", "supporting", "notice"] },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/resource_identity" }, "uniqueItems": true },
        "notices": { "type": "array", "items": { "$ref": "#/$defs/resource_identity" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
