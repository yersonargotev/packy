{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v7/pack-status.schema.json",
  "title": "Packy capability-pack status reports v7",
  "$defs": {
    "optional_bool": {
      "type": "object",
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "configured",
        "authorized",
        "usable"
      ],
      "properties": {
        "configured": {
          "$ref": "#/$defs/optional_bool"
        },
        "authorized": {
          "$ref": "#/$defs/optional_bool"
        },
        "usable": {
          "$ref": "#/$defs/optional_bool"
        }
      },
      "additionalProperties": false
    },
    "optional_authority": {
      "type": "object",
      "required": [
        "mode_id",
        "authority",
        "state",
        "fallback"
      ],
      "properties": {
        "mode_id": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "state": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "fallback": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "pack",
        "pack_version",
        "surface",
        "intent",
        "lifecycle_state",
        "activation_role",
        "consumers",
        "update_available",
        "latest_attempt",
        "projection_summary",
        "projection_details",
        "resource_selections",
        "contract",
        "readiness",
        "optional_authorities",
        "blockers",
        "evidence",
        "pending_human_actions",
        "resources"
      ],
      "properties": {
        "pack": {
          "type": "string"
        },
        "pack_version": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "claude",
            "codex",
            "opencode"
          ]
        },
        "intent": {
          "type": "object",
          "required": [
            "state",
            "active",
            "revision",
            "selection",
            "provider_choices"
          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "known"
              ]
            },
            "active": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "revision": {
              "type": [
                "integer",
                "null"
              ]
            },
            "version": {
              "type": "string"
            },
            "selection": {
              "$ref": "#/$defs/selection"
            },
            "provider_choices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/provider_choice"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "lifecycle_state": {
          "enum": [
            "active",
            "inactive-clean",
            "inactive-with-residuals",
            "recovery-required"
          ]
        },
        "update_available": {
          "type": "boolean"
        },
        "latest_attempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "outcome",
                "plan_id"
              ],
              "properties": {
                "outcome": {
                  "enum": [
                    "applying",
                    "verified",
                    "recovery-required",
                    "unknown"
                  ]
                },
                "plan_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "projection_summary": {
          "type": "object",
          "required": [
            "verified",
            "missing",
            "drifted",
            "ambiguous",
            "unmanaged"
          ],
          "properties": {
            "verified": {
              "type": "integer"
            },
            "missing": {
              "type": "integer"
            },
            "drifted": {
              "type": "integer"
            },
            "ambiguous": {
              "type": "integer"
            },
            "unmanaged": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "projection_details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "target",
              "owner",
              "health",
              "observed_fingerprint",
              "desired_fingerprint",
              "contributors",
              "shared",
              "discoverable_by"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "not": {
                  "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
                }
              },
              "owner": {
                "type": "string"
              },
              "health": {
                "enum": [
                  "verified",
                  "missing",
                  "drifted",
                  "ambiguous",
                  "unmanaged"
                ]
              },
              "observed_fingerprint": {
                "type": "string"
              },
              "desired_fingerprint": {
                "type": "string"
              },
              "contributors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:surface:(?:codex|opencode|claude):)?pack:[a-z0-9][a-z0-9._-]*:[a-z_]+:[a-z0-9][a-z0-9._-]*$"
                },
                "uniqueItems": true
              },
              "shared": {
                "type": "boolean"
              },
              "discoverable_by": {
                "type": ["array", "null"],
                "items": {
                  "enum": ["codex", "opencode", "claude"]
                },
                "uniqueItems": true
              },
              "discovery_notice": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "contract": {
          "$ref": "lifecycle-contract.schema.json"
        },
        "runtime_modes": {
          "type": "array",
          "items": {
            "$ref": "runtime-mode.schema.json"
          },
          "uniqueItems": true
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "optional_authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/optional_authority"
          },
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pending_human_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resource_selections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resource",
              "selected",
              "role",
              "dependency_chain"
            ],
            "properties": {
              "resource": {
                "$ref": "#/$defs/resource_identity"
              },
              "selected": {
                "type": "boolean"
              },
              "role": {
                "enum": [
                  "root",
                  "dependency",
                  "asset",
                  "notice",
                  "unselected"
                ]
              },
              "dependency_chain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_status"
          }
        },
        "activation_role": {
          "enum": [
            "inactive",
            "explicit",
            "required",
            "explicit-required"
          ]
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_consumer"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resource_identity": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "instruction",
            "mcp_server",
            "lifecycle",
            "agent",
            "command",
            "asset",
            "notice"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "mode",
        "roots"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all",
            "custom"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_identity"
          },
          "uniqueItems": true,
          "maxItems": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "all"
            },
            "roots": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "custom"
            },
            "roots": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "resource_status": {
      "type": "object",
      "required": [
        "resource",
        "role",
        "dependency_chain",
        "readiness",
        "projection_summary",
        "blockers"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/resource_identity"
        },
        "role": {
          "enum": [
            "root",
            "dependency",
            "asset",
            "notice"
          ]
        },
        "dependency_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_identity"
          }
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "projection_summary": {
          "type": "object",
          "required": [
            "verified",
            "missing",
            "drifted",
            "ambiguous",
            "unmanaged"
          ],
          "properties": {
            "verified": {
              "type": "integer"
            },
            "missing": {
              "type": "integer"
            },
            "drifted": {
              "type": "integer"
            },
            "ambiguous": {
              "type": "integer"
            },
            "unmanaged": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "provider_choice": {
      "type": "object",
      "required": [
        "capability",
        "provider_pack"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "provider_pack": {
          "type": "string",
          "minLength": 1
        },
        "provider_resource": {
          "$ref": "#/$defs/resource_identity"
        }
      },
      "additionalProperties": false
    },
    "capability_consumer": {
      "type": "object",
      "required": [
        "consumer_pack",
        "consumer_resource",
        "capability"
      ],
      "properties": {
        "consumer_pack": {
          "type": "string",
          "minLength": 1
        },
        "consumer_resource": {
          "oneOf": [
            {
              "$ref": "#/$defs/resource_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 7
    },
    "report": {
      "enum": [
        "pack-status",
        "pack-status-overview"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "uniqueItems": true
    },
    "focused_resource": {
      "$ref": "#/$defs/resource_status"
    },
    "requirement": {
      "type": "object",
      "required": [
        "readiness",
        "satisfied"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/resource_identity"
        },
        "readiness": {
          "const": "usable"
        },
        "satisfied": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
