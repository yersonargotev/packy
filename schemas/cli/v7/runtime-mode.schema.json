{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v7/runtime-mode.schema.json",
  "title": "Packy evaluated runtime mode v4",
  "$defs": {
    "scope": {
      "enum": [
        "consumer_project",
        "pack_resource",
        "workstation",
        "local_git",
        "remote_git",
        "vercel_account",
        "vercel_project",
        "deployment_payload"
      ]
    },
    "observation": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "observed_at",
        "observer_revision"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "unavailable",
            "unverified"
          ]
        },
        "reason": {
          "enum": [
            "verified",
            "not_found",
            "permission_denied",
            "version_mismatch",
            "observer_error",
            "stale"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "observer_revision": {
          "type": "string",
          "minLength": 1
        },
        "redacted_identity": {
          "type": "string"
        }
      }
    },
    "requirement_observation": {
      "allOf": [
        {
          "$ref": "#/$defs/observation"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "tool",
                "authentication",
                "project_link",
                "entitlement",
                "service_data"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "authority_observation": {
      "allOf": [
        {
          "$ref": "#/$defs/observation"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "scope"
          ],
          "properties": {
            "kind": {
              "enum": [
                "filesystem_read",
                "filesystem_write",
                "process_execute",
                "network",
                "environment_inspect",
                "secret_use",
                "package_manager_execute",
                "git_inspect",
                "git_commit",
                "git_push",
                "vercel_project_mutate",
                "vercel_environment_mutate",
                "vercel_domain_mutate",
                "preview_deploy",
                "production_deploy",
                "upload",
                "subagent_delegate"
              ]
            },
            "scope": {
              "$ref": "#/$defs/scope"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "required": [
    "resource_id",
    "mode_id",
    "role",
    "state",
    "requirements",
    "authorities",
    "effects",
    "fallback",
    "on_unavailable",
    "evidence",
    "affected"
  ],
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "mode_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "primary",
        "fallback_only"
      ]
    },
    "state": {
      "enum": [
        "available",
        "unavailable",
        "unverified"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tool",
              "authentication",
              "project_link",
              "entitlement",
              "service_data"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "filesystem_read",
              "filesystem_write",
              "process_execute",
              "network",
              "environment_inspect",
              "secret_use",
              "package_manager_execute",
              "git_inspect",
              "git_commit",
              "git_push",
              "vercel_project_mutate",
              "vercel_environment_mutate",
              "vercel_domain_mutate",
              "preview_deploy",
              "production_deploy",
              "upload",
              "subagent_delegate"
            ]
          },
          "scope": {
            "$ref": "#/$defs/scope"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "authentication_state_change",
              "consumer_project_file_change",
              "consumer_project_dependency_change",
              "local_git_change",
              "remote_git_change",
              "tool_installation",
              "vercel_project_change",
              "vercel_environment_change",
              "vercel_domain_change",
              "upload",
              "preview_deployment",
              "production_deployment"
            ]
          },
          "scope": {
            "$ref": "#/$defs/scope"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "fallback": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "mode"
          ]
        },
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fallback_state": {
      "enum": [
        "available",
        "unavailable",
        "unverified"
      ]
    },
    "on_unavailable": {
      "const": "fail_before_effects"
    },
    "evidence": {
      "type": "object",
      "required": [
        "requirements",
        "authorities"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_observation"
          },
          "uniqueItems": true
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authority_observation"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "affected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
