{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v7/pack-show.schema.json",
  "title": "Packy current pack show report v7",
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "catalog_state",
    "id",
    "version",
    "description",
    "catalog_identity",
    "surfaces",
    "requires",
    "resource_counts",
    "resource_inventory",
    "lifecycle_availability",
    "surface_contracts",
    "resource_graph"
  ],
  "properties": {
    "schema_version": {
      "const": 7
    },
    "report": {
      "const": "pack-show"
    },
    "catalog_state": {
      "enum": [
        "current",
        "retained"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "catalog_identity": {
      "type": "object",
      "required": [
        "pack_id",
        "version",
        "schema_version",
        "limitation"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "enum": [
          "claude",
          "codex",
          "opencode"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resource_counts": {
      "type": "object"
    },
    "resource_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/descriptive_resource"
      },
      "uniqueItems": true
    },
    "lifecycle_availability": {
      "type": "object"
    },
    "surface_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface",
          "catalog_identity",
          "contract",
          "intent"
        ],
        "properties": {
          "surface": {
            "enum": [
              "claude",
              "codex",
              "opencode"
            ]
          },
          "catalog_identity": {
            "$ref": "#/$defs/catalog_identity"
          },
          "contract": {
            "type": "object",
            "required": [
              "resource_definitions"
            ],
            "properties": {
              "resource_definitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "resource",
                    "surface",
                    "definition",
                    "notices"
                  ],
                  "properties": {
                    "resource": {
                      "type": "object",
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "skill",
                            "agent",
                            "command",
                            "instruction",
                            "asset",
                            "notice",
                            "mcp_server",
                            "lifecycle"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "surface": {
                      "enum": [
                        "codex",
                        "claude",
                        "opencode"
                      ]
                    },
                    "definition": {
                      "enum": [
                        "common",
                        "surface_variant"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "origin": {
                      "type": "object",
                      "required": [
                        "id",
                        "path",
                        "relationship"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "relationship": {
                          "enum": [
                            "exact-copy",
                            "adapted"
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "notices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "kind",
                          "id"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "skill",
                              "agent",
                              "command",
                              "instruction",
                              "asset",
                              "notice",
                              "mcp_server",
                              "lifecycle"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "intent": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "resource_graph": {
      "type": "object"
    }
  },
  "$defs": {
    "catalog_identity": {
      "type": "object",
      "required": [
        "pack_id",
        "version",
        "schema_version",
        "limitation"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resource_identity": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "instruction",
            "mcp_server",
            "lifecycle",
            "agent",
            "command",
            "asset",
            "notice"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "descriptive_resource": {
      "type": "object",
      "required": [
        "resource",
        "description",
        "role",
        "dependencies",
        "notices"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/resource_identity"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "operational",
            "supporting",
            "notice"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_identity"
          },
          "uniqueItems": true
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_identity"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
