{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v4/pack-show.schema.json",
  "title": "Packy current pack show report v4",
  "type": "object",
  "required": ["schema_version", "report", "catalog_state", "id", "version", "description", "source_identity", "surfaces", "requires", "resource_counts", "lifecycle_availability", "surface_contracts", "resource_graph"],
  "properties": {
    "schema_version": { "const": 4 },
    "report": { "const": "pack-show" },
    "catalog_state": { "const": "current" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source_identity": {
      "type": "object",
      "required": ["pack_id", "version", "schema_version", "limitation"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "surfaces": { "type": "array", "items": { "enum": ["claude", "codex", "opencode"] }, "minItems": 1, "uniqueItems": true },
    "requires": {
      "type": "object",
      "required": ["tools"],
      "properties": { "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } },
      "additionalProperties": false
    },
    "resource_counts": { "type": "object" },
    "lifecycle_availability": { "type": "object" },
    "surface_contracts": { "type": "array" },
    "resource_graph": { "type": "object" }
  },
  "additionalProperties": false
}
