{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v9/pack-lifecycle.schema.json",
  "title": "Packy capability-pack lifecycle reports v9",
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "consent": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "optional_bool": {
      "type": "object",
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "configured",
        "authorized",
        "usable"
      ],
      "properties": {
        "configured": {
          "$ref": "#/$defs/optional_bool"
        },
        "authorized": {
          "$ref": "#/$defs/optional_bool"
        },
        "usable": {
          "$ref": "#/$defs/optional_bool"
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "schema_version",
        "report",
        "plan_id",
        "operation",
        "disposition",
        "digest",
        "pack",
        "pack_version",
        "surface",
        "intent_revision",
        "document_revision",
        "selection",
        "contract",
        "aliases",
        "blockers",
        "phases",
        "pending_human_actions",
        "expected_readiness",
        "readiness_observed",
        "evidence",
        "pending_evidence",
        "mandatory_actions",
        "contract_diff",
        "dry_run",
        "resource_graph",
        "sensitive_effects"
      ],
      "properties": {
        "schema_version": {
          "const": 9
        },
        "report": {
          "const": "pack-lifecycle-preview"
        },
        "plan_id": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "activate",
            "update",
            "deactivate"
          ]
        },
        "disposition": {
          "enum": [
            "converged",
            "applicable",
            "blocked",
            "mixed"
          ]
        },
        "digest": {
          "type": "string"
        },
        "pack": {
          "type": "string"
        },
        "pack_version": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "claude",
            "codex",
            "opencode"
          ]
        },
        "intent_revision": {
          "type": "integer",
          "minimum": 0
        },
        "document_revision": {
          "type": "integer",
          "minimum": 0
        },
        "contract": {
          "$ref": "lifecycle-contract.schema.json"
        },
        "runtime_modes": {
          "type": "array",
          "items": {
            "$ref": "runtime-mode.schema.json"
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Kind",
              "Subject",
              "Detail"
            ],
            "properties": {
              "Kind": {
                "type": "string"
              },
              "Subject": {
                "type": "string"
              },
              "Detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "digest",
              "approval_required",
              "actions"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "digest": {
                "type": "string"
              },
              "approval_required": {
                "type": "boolean"
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "pending_human_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_readiness": {
          "type": "object",
          "required": [
            "Configured",
            "Authorized",
            "Usable"
          ],
          "properties": {
            "Configured": {
              "type": "boolean"
            },
            "Authorized": {
              "type": "boolean"
            },
            "Usable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "readiness_observed": {
          "type": "object",
          "required": [
            "Configured",
            "Authorization",
            "Usability"
          ],
          "properties": {
            "Configured": {
              "type": "boolean"
            },
            "Authorization": {
              "type": "boolean"
            },
            "Usability": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "contract_diff": {
          "type": "object",
          "required": [
            "added",
            "changed",
            "removed",
            "retained"
          ],
          "properties": {
            "added": {
              "type": "array"
            },
            "changed": {
              "type": "array"
            },
            "removed": {
              "type": "array"
            },
            "retained": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "dry_run": {
          "type": "boolean"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "resource_graph": {
          "type": "object",
          "required": [
            "resources"
          ],
          "properties": {
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "resource",
                  "role",
                  "dependency_chain",
                  "requires",
                  "notices"
                ],
                "properties": {
                  "resource": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "role": {
                    "enum": [
                      "root",
                      "dependency",
                      "asset",
                      "notice",
                      "unselected"
                    ]
                  },
                  "dependency_chain": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "requires": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "notices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "sensitive_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sensitive_effect_origin"
          }
        }
      },
      "additionalProperties": false
    },
    "resource_identity": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "instruction",
            "mcp_server",
            "lifecycle",
            "agent",
            "command",
            "asset",
            "notice"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "mode",
        "roots"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all",
            "custom"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_identity"
          },
          "uniqueItems": true,
          "maxItems": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "all"
            },
            "roots": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "custom"
            },
            "roots": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sensitive_effect_origin": {
      "type": "object",
      "required": [
        "pack",
        "resource",
        "root",
        "dependency_chain",
        "prompt_authorities",
        "runtime_authorities",
        "runtime_effects"
      ],
      "properties": {
        "pack": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "$ref": "#/$defs/resource_identity"
        },
        "root": {
          "$ref": "#/$defs/resource_identity"
        },
        "dependency_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource_identity"
          }
        },
        "prompt_authorities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtime_authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_authority_origin"
          }
        },
        "runtime_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_effect_origin"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime_authority_origin": {
      "type": "object",
      "required": [
        "mode_id",
        "kind"
      ],
      "properties": {
        "mode_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtime_effect_origin": {
      "type": "object",
      "required": [
        "mode_id",
        "kind"
      ],
      "properties": {
        "mode_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "report",
        "plan",
        "verified",
        "projections",
        "readiness",
        "pending_human_actions"
      ],
      "properties": {
        "schema_version": {
          "const": 9
        },
        "report": {
          "const": "pack-lifecycle-apply"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "verified": {
          "type": "boolean"
        },
        "projections": {
          "type": "integer",
          "minimum": 0
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "pending_human_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "report",
        "stage",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": 9
        },
        "report": {
          "const": "pack-lifecycle-failure"
        },
        "stage": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "actions_executed": {
          "type": "integer",
          "minimum": 0
        },
        "approval_requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  ]
}
