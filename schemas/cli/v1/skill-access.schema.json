{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v1/skill-access.schema.json",
  "title": "On-demand Skill Access v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report": {
      "const": "skill-access"
    },
    "result": {
      "enum": [
        "prepared",
        "failed"
      ]
    },
    "qualified_skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "entry_document": {
      "type": "string",
      "minLength": 1
    },
    "resource_root": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_arguments",
            "invalid_identity",
            "unsupported_surface",
            "catalog_unavailable",
            "snapshot_unavailable",
            "unknown_skill",
            "incompatible_resource",
            "preparation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "qualified_skill",
          "pack_version",
          "surface",
          "snapshot_id",
          "entry_document",
          "resource_root",
          "prerequisites"
        ],
        "properties": {
          "qualified_skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "pack_version": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "entry_document": {
            "type": "string",
            "minLength": 1
          },
          "resource_root": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "required": [
          "qualified_skill",
          "pack_version",
          "surface",
          "snapshot_id",
          "entry_document",
          "resource_root",
          "prerequisites",
          "dependencies"
        ],
        "properties": {
          "error": false
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "properties": {
          "qualified_skill": false,
          "pack_version": false,
          "surface": false,
          "snapshot_id": false,
          "entry_document": false,
          "resource_root": false,
          "prerequisites": false,
          "dependencies": false
        }
      }
    }
  ]
}
