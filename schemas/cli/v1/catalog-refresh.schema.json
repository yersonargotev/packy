{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v1/catalog-refresh.schema.json",
  "title": "Packy catalog refresh report v1",
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "catalogs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report": {
      "const": "catalog-refresh"
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "repository",
          "result",
          "snapshot_id"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]*[a-z0-9_-][a-z0-9_.-]*/[a-z0-9_.-]*[a-z0-9_-][a-z0-9_.-]*$"
          },
          "result": {
            "enum": [
              "selected",
              "failed"
            ]
          },
          "snapshot_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "result": {
              "const": "failed"
            }
          }
        },
        "then": {
          "required": [
            "error"
          ]
        },
        "else": {
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
