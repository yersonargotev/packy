{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v1/plugin-export.schema.json",
  "title": "Packy plugin export v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "originPath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "not": {
                "pattern": "(^|/)\\.[gG][iI][tT](/|$)"
              }
            }
          ]
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//|/$"
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report": {
      "const": "plugin-export"
    },
    "result": {
      "enum": [
        "exported",
        "failed"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pack_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "const": "agents"
    },
    "format": {
      "const": "agent-plugins"
    },
    "selected_skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "source"
        ],
        "properties": {
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "skill",
                  "asset",
                  "notice",
                  "agent"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:\\s]+(?:/[^/\\\\:\\s]+)*$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:\\s]+(?:/[^/\\\\:\\s]+)*$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "relationship"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "$ref": "#/$defs/originPath"
              },
              "relationship": {
                "enum": [
                  "exact-copy",
                  "adapted"
                ]
              }
            }
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource",
                "resolution",
                "description"
              ],
              "properties": {
                "resource": {
                  "type": "string",
                  "pattern": "^agent:[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "resolution": {
                  "enum": [
                    "external",
                    "adapted"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "plugin_name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "output_directory": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_arguments",
            "catalog_unavailable",
            "snapshot_unavailable",
            "export_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "exported"
          }
        }
      },
      "then": {
        "required": [
          "snapshot_id",
          "pack_id",
          "pack_version",
          "surface",
          "format",
          "selected_skills",
          "resources",
          "plugin_name",
          "output_directory",
          "content_sha256",
          "prerequisites"
        ],
        "properties": {
          "error": false
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "properties": {
          "snapshot_id": false,
          "pack_id": false,
          "pack_version": false,
          "surface": false,
          "format": false,
          "selected_skills": false,
          "resources": false,
          "plugin_name": false,
          "output_directory": false,
          "content_sha256": false,
          "prerequisites": false
        }
      }
    }
  ]
}
