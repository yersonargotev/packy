{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v1/skill-discovery.schema.json",
  "title": "Current catalog skill discovery v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report": {
      "const": "skill-discovery"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "claude",
        "agents"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource": {
            "$ref": "#/$defs/resourceIdentity"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "const": "operational"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resourceIdentity"
            },
            "uniqueItems": true
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resourceIdentity"
            },
            "uniqueItems": true
          },
          "qualified_skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "pack_version": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource": {
                "$ref": "#/$defs/resourceIdentity"
              },
              "surface": {
                "enum": [
                  "claude",
                  "agents"
                ]
              },
              "definition": {
                "enum": [
                  "common",
                  "surface_variant"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relationship": {
                    "enum": [
                      "exact-copy",
                      "adapted"
                    ]
                  }
                },
                "required": [
                  "id",
                  "path",
                  "relationship"
                ]
              },
              "notices": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/resourceIdentity"
                }
              }
            },
            "required": [
              "resource",
              "surface",
              "definition",
              "notices"
            ]
          },
          "supported_surfaces": {
            "type": "array",
            "items": {
              "enum": [
                "claude",
                "agents"
              ]
            },
            "uniqueItems": true
          },
          "native_name": {
            "type": "string"
          },
          "exclusion": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "surface": {
                    "enum": [
                      "claude",
                      "agents"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "optional",
                      "mandatory"
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "surface",
                  "mode",
                  "code",
                  "reason"
                ]
              }
            ]
          },
          "on_demand": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/onDemand"
              }
            ]
          },
          "compatible": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "plugin_exports": {
            "$ref": "#/$defs/pluginExports"
          }
        },
        "required": [
          "resource",
          "description",
          "role",
          "dependencies",
          "notices",
          "qualified_skill",
          "pack_id",
          "pack_version",
          "definition",
          "supported_surfaces",
          "native_name",
          "exclusion",
          "on_demand",
          "compatible",
          "reason",
          "prerequisites"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "compatible": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "on_demand": {
                  "$ref": "#/$defs/onDemand"
                },
                "native_name": {
                  "type": "string",
                  "minLength": 1
                },
                "exclusion": {
                  "type": "null"
                },
                "reason": {
                  "const": ""
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "prerequisites_verified": {
      "const": false
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "report",
    "pack_id",
    "pack_version",
    "surface",
    "skills",
    "prerequisites_verified",
    "limitation"
  ],
  "$defs": {
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "asset",
            "notice",
            "instruction",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "onDemand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "skill-tree-v1"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entry_document": {
          "type": "string",
          "minLength": 1
        },
        "reference_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "skill"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "type",
              "target"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "prerequisites"
      ]
    },
    "pluginExports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "name",
          "prerequisites",
          "references",
          "roles"
        ],
        "properties": {
          "format": {
            "enum": [
              "agent-plugins",
              "claude-plugin"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/$defs/path"
              },
              {
                "not": {
                  "pattern": "[:\\p{Cc}]"
                }
              }
            ]
          },
          "origin": {
            "$ref": "#/$defs/resourceOrigin"
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "file",
                "target",
                "kind"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "file": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/path"
                    },
                    {
                      "not": {
                        "pattern": "[:\\p{Cc}]"
                      }
                    }
                  ]
                },
                "target": {
                  "type": "string",
                  "pattern": "^(skill|asset|notice):[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "kind": {
                  "enum": [
                    "name",
                    "path",
                    "invocation"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "invocation"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "target": {
                        "pattern": "^skill:"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "value": false
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "name"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "target": {
                        "pattern": "^skill:"
                      }
                    }
                  }
                }
              ]
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource",
                "resolution",
                "description"
              ],
              "properties": {
                "resource": {
                  "type": "string",
                  "pattern": "^agent:[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "resolution": {
                  "enum": [
                    "external",
                    "adapted"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "origin"
              ]
            },
            "then": {
              "required": [
                "source"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "roles": {
                  "contains": {
                    "properties": {
                      "resolution": {
                        "const": "adapted"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "source"
              ]
            }
          }
        ]
      }
    },
    "resourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "relationship"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/originPath"
        },
        "relationship": {
          "enum": [
            "exact-copy",
            "adapted"
          ]
        }
      }
    },
    "originPath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "not": {
                "pattern": "(^|/)\\.[gG][iI][tT](/|$)"
              }
            }
          ]
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//|/$"
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
