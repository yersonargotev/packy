{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yersonargotev.github.io/packy/schemas/cli/v1/pack-list.schema.json",
  "title": "Packy Pack list report v1",
  "type": "object",
  "required": ["schema_version", "report", "packs"],
  "properties": {
    "schema_version": { "const": 1 },
    "report": { "const": "pack-list" },
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "description", "surfaces"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["claude", "codex", "opencode"] }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
