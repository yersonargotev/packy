{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Catalog validation v1",
  "required": [
    "schema_version",
    "report",
    "result",
    "fitness_rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report": {
      "const": "catalog-validation"
    },
    "result": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "fitness_rows": {
      "type": "integer",
      "minimum": 0
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "manifest_sha256",
          "closure_sha256",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "closure_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_arguments",
            "origin_setup_failed",
            "validation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "result": {
          "const": "valid"
        }
      },
      "required": [
        "packs"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "result": {
          "const": "invalid"
        },
        "fitness_rows": {
          "const": 0
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "packs"
        ]
      }
    }
  ]
}
