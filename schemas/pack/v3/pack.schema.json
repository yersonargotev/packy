{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yersonargotev/packy/schemas/pack/v3/pack.schema.json",
  "title": "Pack manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "selectable",
    "surfaces",
    "readiness_obligations",
    "external_requirements",
    "origins",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "selectable": {
      "type": "boolean"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "agents"
        ]
      }
    },
    "readiness_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "runtime-usability",
          "surface-authorization"
        ]
      }
    },
    "external_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/origin"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//|/$"
          }
        }
      ]
    },
    "originPath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "not": {
                "pattern": "(^|/)\\.[gG][iI][tT](/|$)"
              }
            }
          ]
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "commit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "relationship"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/originPath"
        },
        "relationship": {
          "enum": [
            "exact-copy",
            "adapted"
          ]
        }
      }
    },
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "instruction",
            "agent",
            "asset",
            "notice"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "agentAuthorityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable",
        "declarations",
        "outcome",
        "claude_tools",
        "fallback"
      ],
      "properties": {
        "portable": {
          "type": "string"
        },
        "declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": "string"
        },
        "claude_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        }
      }
    },
    "agentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission_mode",
        "authorities"
      ],
      "properties": {
        "permission_mode": {
          "type": "string"
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentAuthorityRecord"
          }
        }
      }
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "claude_agent_document"
          ],
          "properties": {
            "type": {
              "const": "claude-agent-document"
            },
            "claude_agent_document": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skills",
                "authority"
              ],
              "properties": {
                "skills": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resourceIdentity"
                  }
                },
                "authority": {
                  "$ref": "#/$defs/agentAuthority"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "claude_composite_skill"
          ],
          "properties": {
            "type": {
              "const": "claude-composite-skill"
            },
            "claude_composite_skill": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dependencies",
                "references"
              ],
              "properties": {
                "dependencies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resourceIdentity"
                  }
                },
                "references": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resourceIdentity"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "external_executable_acquisition"
          ],
          "properties": {
            "type": {
              "const": "external-executable-acquisition"
            },
            "external_executable_acquisition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "project_instruction"
          ],
          "properties": {
            "type": {
              "const": "project-instruction"
            },
            "project_instruction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "source": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/path"
                    },
                    {
                      "pattern": "^instructions/"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "skill_template"
          ],
          "properties": {
            "type": {
              "const": "skill-template"
            },
            "skill_template": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "naming"
              ],
              "properties": {
                "naming": {
                  "enum": [
                    "native",
                    "pack"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "projection",
        "name",
        "invocation",
        "mode",
        "sharing",
        "capabilities"
      ],
      "properties": {
        "client_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client",
            "scopes"
          ],
          "properties": {
            "client": {
              "enum": [
                "codex",
                "claude"
              ]
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "global",
                  "project"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "surface": {
          "enum": [
            "claude",
            "agents"
          ]
        },
        "projection": {
          "enum": [
            "skill",
            "instruction",
            "agent"
          ]
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "native",
            "degraded"
          ]
        },
        "degradation": {
          "type": "string"
        },
        "sharing": {
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "projection": {
                "const": "agent"
              }
            }
          },
          "then": {
            "required": [
              "client_projection"
            ]
          },
          "else": {
            "properties": {
              "client_projection": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface": {
                "const": "agents"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "native"
              },
              "degradation": false,
              "client_projection": {
                "properties": {
                  "client": {
                    "const": "codex"
                  },
                  "scopes": {
                    "const": [
                      "global"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "client_projection": {
                "properties": {
                  "client": {
                    "const": "claude"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "surfaceExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "mode",
        "code",
        "reason"
      ],
      "properties": {
        "surface": {
          "enum": [
            "claude",
            "agents"
          ]
        },
        "mode": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "code": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "description",
        "requires",
        "conflicts",
        "bindings",
        "surface_exclusions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "asset",
            "instruction",
            "notice",
            "skill"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/resourceOrigin"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "surface_exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceExclusion"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceVariant"
          }
        },
        "on_demand": {
          "$ref": "#/$defs/onDemandSkill"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source",
              "mode",
              "tools",
              "permissions"
            ],
            "properties": {
              "source": {
                "pattern": "^agents/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "asset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "pattern": "^assets/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instruction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "pattern": "^instructions/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "notice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source",
              "license",
              "attribution"
            ],
            "properties": {
              "source": {
                "pattern": "^notices/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "pattern": "^skills/"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "source",
              "notices"
            ],
            "properties": {
              "notices": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "attribution"
                        ]
                      },
                      {
                        "required": [
                          "license"
                        ]
                      },
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "permissions"
                        ]
                      },
                      {
                        "required": [
                          "tools"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "attribution"
                        ]
                      },
                      {
                        "required": [
                          "license"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instruction"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "attribution"
                        ]
                      },
                      {
                        "required": [
                          "license"
                        ]
                      },
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "permissions"
                        ]
                      },
                      {
                        "required": [
                          "tools"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "asset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "attribution"
                        ]
                      },
                      {
                        "required": [
                          "license"
                        ]
                      },
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "permissions"
                        ]
                      },
                      {
                        "required": [
                          "tools"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "notice"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "variants": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "permissions"
                        ]
                      },
                      {
                        "required": [
                          "tools"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "skill"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "on_demand": false,
              "variants": {
                "items": {
                  "properties": {
                    "on_demand": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "on_demand"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "contains": {
                  "type": "object",
                  "required": [
                    "surface"
                  ],
                  "properties": {
                    "surface": {
                      "enum": [
                        "claude",
                        "agents"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "resourceVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface"
      ],
      "properties": {
        "surface": {
          "enum": [
            "claude",
            "agents"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "origin": {
          "$ref": "#/$defs/resourceOrigin"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "on_demand": {
          "$ref": "#/$defs/onDemandSkill"
        }
      }
    },
    "onDemandSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "prerequisites"
      ],
      "properties": {
        "protocol": {
          "const": "skill-tree-v1"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "entry_document": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:\\s]+(?:/[^/\\\\:\\s]+)*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "reference_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:\\s]+(?:/[^/\\\\:\\s]+)*\\.md$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "const": "skill"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    }
  }
}
